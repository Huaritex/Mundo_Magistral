---
import { centralPhone, centralTel } from '../content/data';
import footerClient from './footer-client.js?url';
---
<footer class="site-footer" data-chapter="footer">
  <div class="container footer-main">
    <div class="footer-brand">
      <img src="/media/logo.svg" width="202" height="56" alt="MundoMagistral" loading="lazy" />
      <p>Cada fórmula es única, como cada paciente.</p>
    </div>
    <nav aria-label="Enlaces del pie de página" class="footer-links">
      <a href="/nosotros">Nosotros</a>
      <a href="/especialidades">Especialidades</a>
      <a href="/formas-farmaceuticas">Formas farmacéuticas</a>
      <a href="/sucursales">Sucursales</a>
      <a href="/medicos">Para médicos</a>
      <a href="/preguntas-frecuentes">Preguntas frecuentes</a>
      <a href="/privacidad">Privacidad</a>
    </nav>
    <div class="footer-contact">
      <span>Atención central</span>
      <a href={`tel:${centralTel}`}>{centralPhone}</a>
      <a class="button button-outline-light" href="/cotizar">Cotizar receta</a>
    </div>
  </div>
  <div class="container footer-bottom">
    <small>© {new Date().getFullYear()} Farmacia MundoMagistral S.R.L.</small>
    <button type="button" id="motion-toggle" class="motion-toggle" aria-pressed="false">Reducir animaciones</button>
  </div>
</footer>
<script type="module" src={footerClient}></script>
