---
import { centralWhatsapp } from '../content/data';
const links = [
  { href: '/', label: 'Inicio' },
  { href: '/nosotros', label: 'Nosotros' },
  { href: '/especialidades', label: 'Especialidades' },
  { href: '/formas-farmaceuticas', label: 'Formas farmacéuticas' },
  { href: '/sucursales', label: 'Sucursales' },
  { href: '/medicos', label: 'Para médicos' },
];
---
<div id="header-persist" transition:persist="header">
<header class="site-header" id="site-header" data-tone="light">
  <div class="header-shell">
    <span class="island-glass" aria-hidden="true"></span>
    <a class="brand" href="/" aria-label="MundoMagistral, ir al inicio">
      <img src="/media/logo.svg" width="178" height="49" alt="MundoMagistral" />
    </a>
    <nav class="desktop-nav" aria-label="Navegación principal">
      <span class="nav-pill" aria-hidden="true"></span>
      {links.slice(1).map((link) => (
        <a href={link.href}><span class="lbl"><span class="lbl-a">{link.label}</span><span class="lbl-b" aria-hidden="true">{link.label}</span></span></a>
      ))}
    </nav>
    <div class="cta-zone"><a class="button button-primary header-cta" href="/cotizar">Cotizar receta</a></div>
    <button class="menu-trigger" type="button" id="menu-trigger" aria-haspopup="dialog" aria-controls="menu-dialog" aria-expanded="false" aria-label="Abrir menú">
      <span class="bars" aria-hidden="true"><i></i><i></i></span>
    </button>
    <span class="header-progress" aria-hidden="true"><i></i></span>
  </div>
</header>
<dialog class="menu-dialog" id="menu-dialog" aria-label="Menú principal" data-lenis-prevent>
  <video class="menu-loop" data-menu-loop muted loop playsinline preload="none" aria-hidden="true"></video>
  <div class="menu-dialog-inner">
    <div class="menu-dialog-top menu-anim">
      <span class="menu-brand"><img src="/media/logo.svg" width="178" height="49" alt="" /></span>
      <button type="button" class="menu-close" id="menu-close" aria-label="Cerrar menú">
        <span class="menu-close-label">Cerrar</span>
        <span class="bars" aria-hidden="true"><i></i><i></i></span>
      </button>
    </div>
    <nav aria-label="Navegación móvil">
      {links.map((link) => <a href={link.href}>{link.label}</a>)}
    </nav>
    <div class="menu-foot menu-anim">
      <a class="button button-teal" href="/cotizar">Cotizar receta</a>
      <a class="menu-wa" href={centralWhatsapp} target="_blank" rel="noopener noreferrer">Escribir por WhatsApp</a>
    </div>
  </div>
</dialog>
</div>
<script>
  // Núcleo sin GSAP: el menú funciona aunque el import dinámico de abajo falle.
  import { initHeaderCore } from '../scripts/motion-header-core';
  initHeaderCore();
  // Capa de animación (GSAP + SplitText) en idle.
  const loadMotion = () => {
    import('../scripts/motion-header').then((m) => m.enhanceHeader()).catch((error) => console.warn('Header sin animación GSAP.', error));
  };
  if ('requestIdleCallback' in window) window.requestIdleCallback(loadMotion, { timeout: 2500 });
  else setTimeout(loadMotion, 900);
</script>
