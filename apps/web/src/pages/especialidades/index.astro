---
import Base from '../../layouts/Base.astro';
import SpecialtyCard from '../../components/SpecialtyCard.astro';
import { especialidades } from '../../content/data';
// PROPUESTO: titulares y orientaciones generales. Nombres de especialidad importados son VERIFICADOS.
---
<Base page="especialidades" title="Especialidades" description="Conoce las ocho especialidades atendidas por Farmacia MundoMagistral y solicita una cotización para tu receta magistral." ogImage="/media/og/especialidades.webp">
  <section class="page-hero dark" data-chapter="especialidades"><div class="container"><p class="section-kicker">Medicamentos y cuidados en manos confiables</p><h1>Especialidades</h1><p>Las formulaciones magistrales se elaboran según prescripción médica y las necesidades específicas de cada paciente.</p></div></section>
  <section class="section light" data-chapter="especialidades"><div class="container"><div class="specialty-grid">{especialidades.map((item, index) => <SpecialtyCard item={item} index={index} />)}</div><p class="grid-note">La disponibilidad de una formulación depende de la receta y de la evaluación técnica. Consulta con tu médico y con nuestra farmacia.</p></div></section>
  <section class="section section-tight white"><div class="container split"><h2>¿Ya tienes la receta?</h2><div><p>Envíala para recibir orientación sobre tu solicitud.</p><a class="button button-primary" href="/cotizar">Cotizar receta</a></div></div></section>
</Base>
