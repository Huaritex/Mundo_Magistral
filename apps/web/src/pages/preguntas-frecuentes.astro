---
import Base from '../layouts/Base.astro';
import { faq } from '../content/data';
// PROPUESTO: titulares de página. Cada respuesta declara su estado de fuente en faq.json.
const schema = { '@context': 'https://schema.org', '@type': 'FAQPage', mainEntity: faq.map((item) => ({ '@type': 'Question', name: item.pregunta, acceptedAnswer: { '@type': 'Answer', text: item.respuesta } })) };
---
<Base page="faq" title="Preguntas frecuentes" description="Respuestas sobre preparados magistrales, cotización de recetas, sucursales y atención a profesionales en MundoMagistral." schema={schema} ogImage="/media/og/faq.webp">
  <section class="page-hero dark" data-chapter="faq"><div class="container"><p class="section-kicker">Orientación</p><h1>Preguntas frecuentes</h1><p>Respuestas directas para entender el servicio y encontrar tu siguiente paso.</p></div></section>
  <section class="section white" data-chapter="faq"><div class="container narrow faq-list">{faq.map((item) => <details><summary>{item.pregunta}</summary><p>{item.respuesta}</p></details>)}<div class="faq-contact"><h2>¿Tienes una receta?</h2><a class="button button-primary" href="/cotizar">Cotizar receta</a></div></div></section>
</Base>
