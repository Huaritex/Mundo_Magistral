---
import Base from '../../layouts/Base.astro';
import SedeCard from '../../components/SedeCard.astro';
import { sedes } from '../../content/data';
// PROPUESTO: encabezados y microcopy; datos de sedes importados son VERIFICADOS.
---
<Base page="sedes" title="Sucursales en Bolivia" description="Encuentra las 8 sedes de Farmacia MundoMagistral en 7 departamentos: direcciones, teléfonos y horarios de atención verificados." ogImage="/media/og/sucursales.webp">
  <section class="page-hero dark" data-chapter="sedes"><div class="container"><p class="section-kicker">8 sedes · 7 departamentos</p><h1>Un mundo más cerca de ti.</h1><p>Encuentra tu sucursal y comunícate directamente por teléfono. Dirección, horarios y número de cada sede figuran a continuación.</p></div></section>
  <section class="section light" data-chapter="sedes"><div class="container"><div class="section-head"><h2>Elige tu sede.</h2><p>Las direcciones y horarios provienen del directorio de MundoMagistral. Confirma la atención antes de trasladarte.</p></div><div class="sede-grid">{sedes.map((sede, index) => <SedeCard sede={sede} index={index} />)}</div></div></section>
</Base>
